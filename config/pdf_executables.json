{
    "shellExecutables": {
        "pdfinfo": {
            "path": "pdfinfo",
            "required": true,
            "package": "poppler-utils",
            "description": "Metadaten aus PDF-Datei",
            "arguments": ["[INPUT]", "2>&1"],
            "debugArguments": ["[INPUT]", "2>&1"]
        },
        "valid-pdf": {
            "linuxPath": "mutool",
            "windowsPath": "pdfinfo",
            "package": "mupdf-tools",
            "required": true,
            "description": "PDF-Validierung",
            "linuxArguments": ["info", "[INPUT]", "2>&1 | grep -i 'error'"],
            "windowsArguments": ["[INPUT]", "2>&1 | findstr /R \"Syntax.Error\""]
        },
        "pdf-decrypt": {
            "linuxPath": "qpdf",
            "windowsPath": "qpdf.exe",
            "package": "qpdf",
            "required": false,
            "description": "Entschlüsselt eine geschützte PDF-Datei; [ARGFILE] = @Argumentdatei mit --password=... (nie auf der Befehlszeile) oder leer",
            "linuxArguments": ["[ARGFILE]", "--decrypt", "[INPUT]", "[OUTPUT]"],
            "windowsArguments": ["[ARGFILE]", "--decrypt", "[INPUT]", "[OUTPUT]"],
            "debugArguments": ["[ARGFILE]", "--decrypt", "[INPUT]", "[OUTPUT]"]
        },
        "pdf-encrypt": {
            "linuxPath": "qpdf",
            "windowsPath": "qpdf.exe",
            "package": "qpdf",
            "required": false,
            "description": "Verschlüsselt eine PDF-Datei mit Passwortschutz; [ARGFILE] = @Argumentdatei mit --encrypt ... -- (Passwörter nie auf der Befehlszeile)",
            "linuxArguments": ["[ARGFILE]", "[INPUT]", "[OUTPUT]"],
            "windowsArguments": ["[ARGFILE]", "[INPUT]", "[OUTPUT]"],
            "debugArguments": ["[ARGFILE]", "[INPUT]", "[OUTPUT]"]
        },
        "pdf-check": {
            "linuxPath": "qpdf",
            "windowsPath": "qpdf.exe",
            "package": "qpdf",
            "required": false,
            "description": "Prüft PDF auf Struktur- und Verschlüsselungsstatus",
            "linuxArguments": ["--check", "[INPUT]"],
            "windowsArguments": ["--check", "[INPUT]"],
            "debugArguments": ["--check", "[INPUT]"]
        }
    }
}
